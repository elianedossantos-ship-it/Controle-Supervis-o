# Conexão com o PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/cronograma"

# Segredo usado para assinar a sessão (cookie httpOnly).
# Gere um valor novo por ambiente: openssl rand -base64 32
SESSION_SECRET="troque-este-valor-por-no-minimo-32-caracteres-aleatorios"

# Duração da sessão em dias. O supervisor registra visita em campo:
# a sessão é longa de propósito para ele não relogar a cada visita.
SESSION_DIAS="30"

# Credenciais do usuário admin criado pelo seed (db/seed.ts)
SEED_ADMIN_NOME="Administrador"
SEED_ADMIN_EMAIL="admin@empresa.com.br"
SEED_ADMIN_SENHA="troque-esta-senha"
