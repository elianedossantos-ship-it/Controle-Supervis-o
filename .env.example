# Conexão com o PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/cronograma"

# O pool se configura sozinho a partir da URL acima: uma URL de pooler
# (Supabase, Neon) vira 1 conexão sem prepared statements, que é o certo em
# serverless; uma conexão direta vira um pool de 10. As duas linhas abaixo só
# existem para contrariar essa dedução, e normalmente ficam de fora.
# DB_POOL_MAX="10"
# DB_PREPARE="true"

# Segredo usado para assinar a sessão (cookie httpOnly).
# Gere um valor novo por ambiente: openssl rand -base64 32
SESSION_SECRET="troque-este-valor-por-no-minimo-32-caracteres-aleatorios"

# Duração da sessão em dias. O supervisor registra visita em campo:
# a sessão é longa de propósito para ele não relogar a cada visita.
SESSION_DIAS="30"

# Credenciais do usuário admin criado pelo seed (db/seed.ts)
SEED_ADMIN_NOME="Administrador"
SEED_ADMIN_EMAIL="admin@empresa.com.br"
SEED_ADMIN_SENHA="troque-esta-senha"

# Armazenamento das evidências (seção 11: S3 compatível).
# Sem S3_BUCKET, grava em disco — que serve para desenvolvimento e some com a
# instância em servidor efêmero. Preencher S3_BUCKET já liga o bucket.
STORAGE_LOCAL_DIR="./armazenamento"

S3_BUCKET=""
S3_ENDPOINT=""          # R2: https://<conta>.r2.cloudflarestorage.com
                        # Supabase: https://<ref>.supabase.co/storage/v1/s3
                        # AWS: deixe vazio
S3_REGION="auto"        # Supabase e AWS: a região do projeto (ex.: sa-east-1)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Só mexa nestes para contrariar o padrão.
# STORAGE_DRIVER="s3"
# S3_FORCE_PATH_STYLE="true"
